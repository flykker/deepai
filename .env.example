# Model selection: provider:model (deepagents passes it to init_chat_model).
# Examples: anthropic:claude-sonnet-4-6, openai:gpt-5.1, google_genai:gemini-2.5-pro
AGENT_MODEL=anthropic:claude-sonnet-4-6

# OpenAI-compatible endpoints (proxies): point the `openai` provider here.
# OPENAI_BASE_URL=https://your-proxy.example/v1

# Seconds a single model request may stall before it is aborted and retried
# (defaults: 30 / 4). 0 disables the limit. Only applied to OpenAI-compatible
# specs; other providers keep their own client defaults.
# Секунд тишины на одну попытку: здоровый ответ даёт первый токен за 2-4 с,
# худший наблюдавшийся легитимный — 16 с. Худший случай целиком =
# (AGENT_MODEL_MAX_RETRIES+1) × (таймаут + ~3.5 с).
# 60 с → «залипший» прокси стоил 125-190 с ожидания; 25 с оказалось слишком
# жёстко (SSL-handshake убил все попытки → упал весь ход); 40 с x 2 ретрая
# не пережили ~2-минутный outage прокси. Теперь: 30 с x 5 попыток ≈ до 168 с,
# outage до ~2 мин проходит.
# AGENT_MODEL_TIMEOUT=30
# AGENT_MODEL_MAX_RETRIES=4

# Provider credentials (set the one you use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: LangSmith tracing.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true

# Set to 1 to hide start_background_task/get_task_output/kill_task/list_tasks
# from the model (mirrors Claude Code's CLAUDE_CODE_DISABLE_BACKGROUND_TASKS).
# DEEPAI_DISABLE_BACKGROUND_TASKS=1
